      const b = Array(8).fill(null).map(() => Array(8).fill(null));
      b[0][7] = { type: 'k', color: 'W', id: 'W-k' }; 
      b[2][5] = { type: 'n', color: 'W', id: 'W-n1' }; 
      b[0][4] = { type: 'k', color: 'B', id: 'B-k' }; 
      b[7][7] = { type: 'k', color: 'R', id: 'R-k' };
      b[7][0] = { type: 'k', color: 'K', id: 'K-k' };
      return b;
    },
    controlled: { W: ['W'], B: ['B'], K: ['K'], R: ['R'] },
    turnIndex: 0, 
    playerTypes: { W: 'human', B: 'ai_defensive', K: 'ai_diplomatic', R: 'ai_diplomatic' },
    checkObj: (board, controlled, turnCount) => {
      if (!controlled.B.includes('B')) return 'W'; 
      if (turnCount > 1) return 'Loss';
      return null;
    }
  },
  {
    id: 'p2', title: 'Survive the Horde', description: 'Survive 4 full rounds against aggressive knights.', reward: 100,
