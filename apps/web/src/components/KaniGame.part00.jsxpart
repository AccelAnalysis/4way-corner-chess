      b[3][3] = { type: 'k', color: 'W', id: 'W-k' }; 
      b[3][4] = { type: 'p', color: 'W', id: 'W-p1' }; 
      b[4][3] = { type: 'p', color: 'W', id: 'W-p2' }; 
      b[1][1] = { type: 'n', color: 'R', id: 'R-n1' };
      b[1][6] = { type: 'n', color: 'R', id: 'R-n2' };
      b[6][1] = { type: 'n', color: 'K', id: 'K-n1' };
      b[6][6] = { type: 'n', color: 'K', id: 'K-n2' };
      b[0][0] = { type: 'k', color: 'B', id: 'B-k' }; 
      return b;
    },
    controlled: { W: ['W'], B: ['B'], K: ['K'], R: ['R'] },
    turnIndex: 0,
    playerTypes: { W: 'human', B: 'ai_diplomatic', K: 'ai_aggressive', R: 'ai_aggressive' },
    checkObj: (board, controlled, turnCount) => {
      if (!controlled.W.includes('W')) return 'Loss'; 
      if (turnCount >= 16) return 'W'; 
      return null;
    }
  },
  {
    id: 'p3', title: 'Revenge of the Fallen', description: 'Your White King is dead, but you assimilated Black. Win the game.', reward: 150,
    setup: () => {
      const b = Array(8).fill(null).map(() => Array(8).fill(null));
      b[7][0] = { type: 'k', color: 'W', id: 'K-k-assimilated' }; 
      b[6][1] = { type: 'q', color: 'W', id: 'K-q' };
      b[7][2] = { type: 'r', color: 'W', id: 'K-r1' };
      b[7][7] = { type: 'k', color: 'R', id: 'R-k' };
      b[6][6] = { type: 'q', color: 'R', id: 'R-q' };
      b[5][7] = { type: 'r', color: 'R', id: 'R-r' };
      return b;
    },
    controlled: { W: ['W', 'K'], B: [], K: [], R: ['R'] },
    turnIndex: 0,
    playerTypes: { W: 'human', B: 'ai_diplomatic', K: 'ai_diplomatic', R: 'ai_defensive' },
    checkObj: (board, controlled, turnCount) => {
      if (controlled.W.length === 0) return 'Loss';
      if (controlled.R.length === 0) return 'W';
      return null;
    }
  },
  {
    id: 'p4', title: 'Pawn\'s Journey', description: 'Promote your pawn to win. Avoid the Rook!', reward: 75,
    setup: () => {
      const b = Array(8).fill(null).map(() => Array(8).fill(null));
      b[0][7] = { type: 'k', color: 'W', id: 'W-k' }; 
      b[6][1] = { type: 'p', color: 'W', id: 'W-p1', dir: [1, -1] }; 
      
      b[7][7] = { type: 'k', color: 'R', id: 'R-k' };
      b[7][4] = { type: 'r', color: 'R', id: 'R-r1' }; 
      return b;
    },
    controlled: { W: ['W'], B: [], K: [], R: ['R'] },
    turnIndex: 0,
    playerTypes: { W: 'human', B: 'ai_diplomatic', K: 'ai_diplomatic', R: 'ai_defensive' },
    checkObj: (board, controlled, turnCount, promotionState) => {
      if (controlled.W.length === 0) return 'Loss';
      let hasQueen = false;
      board.forEach(row => row.forEach(p => { if (p && p.color === 'W' && p.type === 'q') hasQueen = true; }));
      if (hasQueen || (promotionState && promotionState.color === 'W')) return 'W'; 
      return null;
    }
  }
];

// --- SVG Piece Renderer ---
const GamePiece = ({ type, color, themeObj }) => {
  if (!themeObj.useSvgPieces) {
     return (
       <div className={`w-11 h-11 rounded-full flex items-center justify-center text-3xl font-bold ${themeObj[color]}`}>
         <span className="drop-shadow-sm pb-1">{PIECE_SYMBOLS[type]}</span>
       </div>
     );
  }

  let c;
  if (themeObj.name === 'African Tribal') {
    const tribalColors = {
      W: { fill: '#f4e6ce', stroke: '#8c4a23' }, 
      B: { fill: '#1a85a1', stroke: '#0c3f4d' }, 
      K: { fill: '#2b2b2b', stroke: '#000000' }, 
      R: { fill: '#bd3a24', stroke: '#5e1307' }, 
    };
    c = tribalColors[color];
  } else {
    const medievalColors = {
      W: { fill: '#fdfdfc', stroke: '#b8860b' }, 
      B: { fill: '#3b82f6', stroke: '#1e3a8a' }, 
      K: { fill: '#27272a', stroke: '#000000' }, 
      R: { fill: '#ef4444', stroke: '#7f1d1d' }, 
    };
    c = medievalColors[color];
  }
  
  const getIcon = () => {
     if (themeObj.name === 'African Tribal') {
         switch(type) {
           case 'k': return <Crown size={38} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
           case 'q': return <Sun size={36} strokeWidth={2} fill={c.fill} color={c.stroke} />;
           case 'r': return <Tent size={34} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
           case 'b': return <Flame size={32} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
           case 'n': return <Axe size={32} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
           case 'p': return <Shield size={28} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
           default: return null;
         }
     }
     switch(type) {
       case 'k': return <Crown size={38} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
       case 'q': return <Sparkles size={34} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
       case 'r': return <Castle size={32} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
       case 'b': return <Flame size={32} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
       case 'n': return <Swords size={32} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
       case 'p': return <Shield size={26} strokeWidth={1.5} fill={c.fill} color={c.stroke} />;
       default: return null;
     }
  }

  return (
     <div className="drop-shadow-[0_6px_4px_rgba(0,0,0,0.6)]">
        {getIcon()}
     </div>
  );
};

export default function App() {
  const [profile, setProfile] = useState({
    coins: 200,
    elo: { ffa: 1200, teams: 1200, blitz: 1200 },
