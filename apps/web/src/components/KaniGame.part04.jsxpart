          .themed-btn:hover { transform: scale(1.02); filter: brightness(1.1); }
        `}</style>
        
        <div className="w-full max-w-3xl">
          <div className="mb-7 flex items-center justify-between">
            <h1 className="text-4xl">Puzzles</h1>
            <button onClick={() => setGameState('hub')} className="kani-link text-sm">Back</button>
          </div>
          <div className="divide-y" style={{ borderColor: 'var(--border-panel)' }}>
            {PUZZLES.map(puz => (
              <button key={puz.id} onClick={() => startPuzzle(puz)}
                className="flex w-full items-center gap-4 border-b py-5 text-left"
                style={{ borderColor: 'var(--border-panel)' }}>
                <Puzzle size={26} aria-hidden="true"/>
                <div className="flex-1">
                  <h2 className="text-xl">{puz.title}</h2>
                  <p className="mt-1 text-sm themed-text-muted">{puz.description}</p>
                </div>
                <ArrowRight size={20} aria-hidden="true"/>
              </button>
            ))}
          </div>
        </div>
      </div>
    );
  }

  // --- GAME SETUP ---
  if (gameState === 'room_setup') {
    return (
      <main className="themed-app min-h-[calc(100svh-56px)] px-5 py-9" style={themeVars}>
        <section className="mx-auto max-w-3xl">
          <div className="mb-8 flex items-center justify-between">
            <h1 className="text-4xl">{playMode === 'ffa' ? 'Free for all' : playMode === 'teams' ? 'Teams' : 'Blitz'}</h1>
            <button onClick={() => setGameState('hub')} className="kani-link">Back</button>
          </div>
          <div className="mb-7 flex items-center gap-5 border-b pb-5" style={{ borderColor: 'var(--border-panel)' }}>
            <span className="font-bold">Local game</span>
            <button onClick={() => window.location.assign('/online')} className="kani-link text-sm">Play online <ArrowRight size={15} className="inline"/></button>
          </div>
          <div className="grid gap-x-8 gap-y-5 sm:grid-cols-2">
            {COLORS.map((color) => (
              <div key={color} className="border-b pb-4" style={{ borderColor: 'var(--border-panel)' }}>
                <label htmlFor={`seat-${color}`} className="mb-2 flex items-center gap-2">
                  <span className={`h-3 w-3 rounded-full border border-black/20 ${THEMES.classic[color]}`}/>
                  {COLOR_NAMES[color]}
                </label>
                <select id={`seat-${color}`} value={playerTypes[color]}
                  onChange={(e) => setPlayerTypes(prev => ({ ...prev, [color]: e.target.value }))}
                  className="themed-select w-full rounded-md border p-3 text-sm">
                  <option value="human">Human</option>
                  <option value="ai_aggressive">Aggressive AI</option>
                  <option value="ai_defensive">Defensive AI</option>
                  <option value="ai_diplomatic">Diplomatic AI</option>
                </select>
                <select value={playerThemes[color]}
                  aria-label={`${COLOR_NAMES[color]} piece style`}
                  onChange={(e) => setPlayerThemes(prev => ({ ...prev, [color]: e.target.value }))}
                  className="themed-select mt-2 w-full rounded-md border p-2 text-sm">
                  {profile.unlockedThemes.map(k => <option key={k} value={k}>{THEMES[k].name}</option>)}
                </select>
              </div>
            ))}
          </div>
          <div className="mt-7 grid gap-5 sm:grid-cols-2">
            <label className="block">Board
              <select value={theme} onChange={e => setTheme(e.target.value)}
                className="themed-select mt-2 w-full rounded-md border p-3 text-sm">
                {profile.unlockedThemes.map(k => <option key={k} value={k}>{THEMES[k].name}</option>)}
              </select>
            </label>
            <label className="block">Clock
              <select value={timeControl || 'unlimited'}
                onChange={e => setTimeControl(e.target.value === 'unlimited' ? null : parseInt(e.target.value))}
                disabled={playMode === 'blitz'}
                className="themed-select mt-2 w-full rounded-md border p-3 text-sm">
                {TIME_OPTIONS.map(opt => <option key={opt.label} value={opt.value || 'unlimited'}>{opt.label}</option>)}
              </select>
            </label>
          </div>
          <button onClick={() => { setGameState('playing'); setupStandardBoard(); }}
            className="kani-action mt-9 w-full"><Play size={20} fill="currentColor"/> Start game</button>
        </section>
      </main>
    );
  }

  // --- GAME / REPLAY RENDER ---
  return (
    <div className="themed-app min-h-screen flex flex-col p-4 items-center transition-colors duration-500" style={themeVars}>
      <style>{`
        .themed-app { background: var(--bg-app); font-family: var(--kani-body); color: var(--text-main); }
        .themed-panel { background: var(--bg-panel); border: var(--border-width) solid var(--border-panel); box-shadow: 0 10px 25px rgba(0,0,0,0.5); color: var(--text-main); }
        .themed-card { background: var(--bg-panel); border: 1px solid var(--border-panel); filter: brightness(0.92); transition: all 0.2s; }
        .themed-card:hover { filter: brightness(1.05); }
        .themed-btn { background: var(--accent-primary); color: var(--accent-text); border: 2px solid var(--border-panel); font-weight: bold; transition: all 0.2s; }
        .themed-btn:hover { transform: scale(1.02); filter: brightness(1.1); box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
        .themed-text-muted { color: var(--text-muted); }
      `}</style>

      {toast && <div className="fixed top-6 bg-slate-900 text-white px-6 py-3 rounded-full shadow-2xl z-50 animate-bounce font-bold font-sans">{toast}</div>}

      {/* Top Info Bar */}
      <div className="max-w-6xl w-full flex justify-between items-center mb-6 themed-panel p-4 rounded-2xl">
         <h1 className="text-2xl font-extrabold leading-tight flex items-center gap-2 drop-shadow-sm">
           {activePuzzle ? <Puzzle className="text-purple-600"/> : <Crown className="text-yellow-600" fill="currentColor"/>}
           {activePuzzle ? `Puzzle: ${activePuzzle.title}` : (gameState === 'replay' ? `Kani: Archives` : `Kani: ${playMode.toUpperCase()}`)}
         </h1>
         <div className="flex items-center gap-4">
            {isOnline && (
              <div className="bg-indigo-100 border border-indigo-300 text-indigo-800 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full flex items-center gap-2 font-sans shadow-sm">
                <Globe size={14} /> Room: {roomCode}
              </div>
            )}
            <button onClick={() => setGameState('hub')} className="themed-card px-4 py-2 rounded-lg font-bold text-sm shadow-sm">
               Surrender
            </button>
         </div>
      </div>

      <div className="max-w-6xl w-full flex flex-col md:flex-row gap-10 items-center md:items-start justify-center">
        
        {/* Game Board Column */}
        <div className="flex flex-col items-center flex-shrink-0">
          
          {/* Turn Flow Tracker */}
          {(!winner || gameState === 'replay') && (
            <div className="flex items-center justify-center gap-3 mb-5 px-3">
              {COLORS.map((color, idx) => {
                const isActive = color === COLORS[displayTurnIndex];
                const isAlive = displayControlled[color].length > 0;
                
                const pieceTheme = THEMES[playerThemes[color]] || THEMES.medieval;

                return (
                  <React.Fragment key={color}>
                    <div className={`relative flex flex-col items-center transition-all duration-300 ${isActive ? 'scale-125 z-10' : (isAlive ? 'opacity-60 grayscale-[0.3]' : 'opacity-30 grayscale')}`}>
                      <div className={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-md transition-all ${pieceTheme[color]}`}>
                        {isAlive ? PIECE_SYMBOLS['k'] : <Skull size={14}/>}
                      </div>
                      {isActive && <div className="absolute -bottom-4 animate-bounce text-yellow-600 font-black drop-shadow-md">▲</div>}
                    </div>
                    {idx < 3 && <div className="themed-text-muted font-bold">→</div>}
                    {idx === 3 && <div className="themed-text-muted font-bold hidden sm:block ml-2">↺</div>}
                  </React.Fragment>
                );
              })}
            </div>
          )}

          <div className={`p-4 rounded-md relative transition-colors duration-500 ${currentTheme.boardOuter}`}>
            
            {/* Victory / Failure Overlay */}
            {(winner && gameState !== 'replay' && showMatchResult) && (
              <div className={`absolute inset-0 z-50 ${winner === 'Loss' ? 'bg-red-900/90' : 'bg-black/80'} backdrop-blur-sm flex flex-col items-center justify-center text-white p-8 font-sans`}>
                {winner === 'Loss' ? <Skull className="mb-4 text-red-500 drop-shadow-lg" size={72}/> : <Trophy className="mb-4 text-yellow-400 drop-shadow-lg" size={72} />}
                <h2 className="text-4xl font-extrabold mb-2 text-center drop-shadow-xl" style={{ fontFamily: 'var(--kani-heading)' }}>
                  {winner === 'Loss' ? 'Defeat' : (winner === 'Draw' ? 'It\'s a Draw!' : (winner.includes('Alliance') ? `${winner} Wins!` : `${COLOR_NAMES[winner]} Wins!`))}
                </h2>
                <p className="text-slate-300 mb-8 text-center text-lg font-medium">{winner === 'Loss' ? 'Play again?' : ''}</p>
                <div className="flex gap-4 flex-wrap justify-center">
                  {activePuzzle ? (
                    <button onClick={() => startPuzzle(activePuzzle, activePuzzle.isDaily)} className="bg-purple-600 hover:bg-purple-700 border-2 border-purple-400 px-6 py-3 rounded-xl font-bold shadow-lg transition-transform hover:scale-105 flex items-center gap-2">
                       <RotateCcw size={20}/> Retry
                    </button>
                  ) : (
                    <button onClick={() => shareResult()} className="bg-blue-600 hover:bg-blue-700 border-2 border-blue-400 px-6 py-3 rounded-xl font-bold shadow-lg transition-transform hover:scale-105 flex items-center gap-2">
                       <Share2 size={20}/> Share Result
                    </button>
                  )}
                  <button onClick={() => { setReplayIndex(0); setGameState('replay'); }} className="bg-slate-700 hover:bg-slate-600 border-2 border-slate-500 px-6 py-3 rounded-xl font-bold shadow-lg transition-transform hover:scale-105 flex items-center gap-2">
                     <FastForward size={20}/> Archives
                  </button>
                  <button onClick={() => setGameState('hub')} className="bg-white text-slate-900 hover:bg-slate-200 px-6 py-3 rounded-xl font-bold shadow-lg transition-transform hover:scale-105 flex items-center gap-2">
                    Main Hub
                  </button>
                </div>
              </div>
            )}

            {/* Promotion Overlay */}
            {promotionState && gameState !== 'replay' && showPromotionOptions && (
              <div className="absolute inset-0 z-40 bg-black/80 backdrop-blur-sm flex flex-col items-center justify-center text-white">
                <h3 className="text-3xl font-black mb-6 drop-shadow-md" style={{ fontFamily: currentTheme.font }}>Promote</h3>
                <div className="flex gap-4 p-6 rounded-2xl" style={{ background: 'rgba(255,255,255,0.1)' }}>
                  {['q', 'r', 'b', 'n'].map(type => (
                    <button 
                      key={type} 
                      onClick={() => handlePromotionSelection(type)}
                      className={`w-20 h-20 rounded-full flex items-center justify-center hover:scale-110 hover:bg-white/20 transition-all`}
                    >
                      <GamePiece type={type} color={promotionState.color} themeObj={THEMES[playerThemes[promotionState.color]] || currentTheme} />
                    </button>
                  ))}
                </div>
              </div>
            )}

