            <div className={`relative overflow-hidden ${(winner && gameState !== 'replay') || promotionState ? 'opacity-30' : ''}`} style={{ width: '480px', height: '480px' }}>
              
              {/* Background Grid */}
              <div className="absolute inset-0 grid grid-cols-8 grid-rows-8">
                {Array.from({length: 8}).map((_, r) => Array.from({length: 8}).map((_, c) => {
                  const isLight = (r + c) % 2 === 0;
                  const isSelected = selected?.r === r && selected?.c === c && gameState === 'playing';
                  const isValidMove = validMoves.some(m => m.r === r && m.c === c) && gameState === 'playing';
                  const isDanger = enemyThreats.has(`${r},${c}`);
                  const isCheck = kingsInCheck.some(k => k.r === r && k.c === c);

                  return (
                    <div
                      key={`bg-${r}-${c}`}
                      onClick={() => { if (gameState === 'playing') handleSquareClick(r, c); }}
                      className={`
                        w-[60px] h-[60px] relative flex items-center justify-center transition-colors duration-300
                        ${(playerTypes[currentPlayer] === 'human' && !winner && !promotionState && gameState === 'playing') ? 'cursor-pointer' : 'cursor-default'}
                        ${isLight ? currentTheme.boardLight : currentTheme.boardDark}
                      `}
                    >
                      {isSelected && <div className="absolute inset-0 bg-yellow-400/40 mix-blend-overlay" />}
                      {isDanger && !isCheck && (
                        <div className="absolute inset-0 bg-red-600/30 pointer-events-none flex items-center justify-center mix-blend-multiply">
                           <Crosshair size={24} className="text-red-900/40" strokeWidth={1} />
                        </div>
                      )}
                      {isCheck && <div className="absolute inset-0 ring-inset ring-[6px] ring-red-600 animate-[pulse_1s_ease-in-out_infinite] z-10 bg-red-600/40 mix-blend-multiply" />}
                      {isValidMove && (
                         <div className="absolute inset-0 flex items-center justify-center pointer-events-none z-10">
                            {displayBoard[r][c] 
                              ? <div className="w-full h-full border-[5px] border-emerald-500 rounded-full scale-90 opacity-90 shadow-[0_0_10px_rgba(16,185,129,0.5)]" /> 
                              : <div className="w-4 h-4 bg-emerald-500 rounded-full shadow-[0_0_10px_rgba(16,185,129,0.8)] opacity-90" />
                            }
                         </div>
                      )}
                    </div>
                  );
                }))}
              </div>

              {/* Capture Animations Layer */}
              {captureEffects.map(effect => (
                <div key={effect.id} className="absolute w-[60px] h-[60px] pointer-events-none z-20 flex items-center justify-center"
                     style={{ transform: `translate(${effect.c * 60}px, ${effect.r * 60}px)` }}>
                  <div className="w-14 h-14 bg-yellow-500 rounded-full animate-ping opacity-80 mix-blend-screen"></div>
                </div>
              ))}

              {/* Floating Active Pieces Layer */}
              {activePieces.map((piece) => {
                const isSelected = selected?.r === piece.r && selected?.c === piece.c && gameState === 'playing';
                const isThreatened = enemyThreats.has(`${piece.r},${piece.c}`);

                return (
                  <div
                    key={piece.id}
                    onClick={(e) => { e.stopPropagation(); if (gameState === 'playing') handleSquareClick(piece.r, piece.c); }}
                    className={`
                      absolute w-[60px] h-[60px] flex items-center justify-center
                      transition-all duration-500 ease-out z-30
                      ${(playerTypes[currentPlayer] === 'human' && !winner && !promotionState && gameState === 'playing') ? 'cursor-pointer hover:brightness-110' : 'cursor-default'}
                      ${isSelected ? 'scale-110 -translate-y-1' : ''}
                      ${isThreatened && theme === 'neon' ? 'animate-pulse' : ''}
                    `}
                    style={{ transform: `translate(${piece.c * 60}px, ${piece.r * 60}px)` }}
                  >
                    <GamePiece type={piece.type} color={piece.color} themeObj={THEMES[playerThemes[piece.color]] || currentTheme} />
                  </div>
                );
              })}

            </div>
          </div>
          
          {/* Replay Scrubber */}
          {gameState === 'replay' && (
             <div className="mt-6 w-full themed-panel p-4 rounded-xl flex flex-col gap-4 font-sans">
                <div className="flex items-center justify-between font-bold text-sm opacity-80">
                   <span>Turn {replayIndex}</span>
                   <span>End</span>
                </div>
                <input 
                  type="range" 
                  min="0" 
                  max={Math.max(0, moveHistory.length - 1)} 
                  value={replayIndex} 
                  onChange={(e) => { setReplayIndex(Number(e.target.value)); setIsPlayingReplay(false); }}
                  className="w-full cursor-pointer"
                />
                <div className="flex justify-center items-center gap-4">
                   <button onClick={() => { setReplayIndex(0); setIsPlayingReplay(false); }} className="p-2 themed-card rounded-lg shadow-sm">
                      <SkipBack size={20} />
                   </button>
                   <button 
                     onClick={() => setIsPlayingReplay(!isPlayingReplay)} 
                     className="p-3 themed-btn rounded-full shadow-md"
                   >
                      {isPlayingReplay ? <Pause size={24} fill="currentColor"/> : <Play size={24} fill="currentColor"/>}
                   </button>
                   <button onClick={() => { setReplayIndex(moveHistory.length - 1); setIsPlayingReplay(false); }} className="p-2 themed-card rounded-lg shadow-sm">
                      <SkipForward size={20} />
                   </button>
                </div>
             </div>
          )}

        </div>

        {/* Info Column */}
        <div className="w-full md:w-80 flex flex-col gap-6">
          
          {activePuzzle && (
            <div className="themed-panel rounded-2xl p-6 flex-grow" style={{ borderColor: 'var(--accent-primary)' }}>
              <h3 className="text-lg font-bold mb-2 flex items-center gap-2 border-b pb-2 drop-shadow-sm" style={{ borderColor: 'var(--border-panel)' }}>
                <Target size={20} /> Objective
              </h3>
              <p className="font-semibold mb-4">{activePuzzle.description}</p>
              <div className="text-sm themed-card p-3 rounded-lg font-mono font-bold text-center">
                Turns Elapsed: {Math.floor(turnCount / 4)}
              </div>
            </div>
          )}

          <div className="themed-panel rounded-2xl flex flex-col flex-grow overflow-hidden">
            
            {/* Tabs for Status vs Comms */}
            <div className="flex w-full font-bold text-sm font-sans border-b" style={{ borderColor: 'var(--border-panel)', background: 'rgba(0,0,0,0.05)' }}>
               <button 
                  onClick={() => setShowChatPane(false)}
                  className={`flex-1 py-3 flex items-center justify-center gap-2 transition-colors ${!showChatPane ? 'bg-transparent text-emerald-600 drop-shadow-sm' : 'opacity-50 hover:opacity-80'}`}
               >
                 <Shield size={16}/> Status
               </button>
               <button 
                  onClick={() => setShowChatPane(true)}
                  className={`flex-1 py-3 flex items-center justify-center gap-2 transition-colors ${showChatPane ? 'bg-transparent text-blue-600 drop-shadow-sm' : 'opacity-50 hover:opacity-80'}`}
               >
                 <MessageSquare size={16}/> Comms 
                 {chatMessages.length > 0 && !showChatPane && <span className="w-2 h-2 bg-red-600 rounded-full shadow-sm"></span>}
               </button>
            </div>

            {/* Pane Content */}
            <div className="p-6 flex-grow flex flex-col font-sans">
              {!showChatPane ? (
                // --- STATUS PANE ---
                <>
                  <div className="flex items-center justify-between mb-4">
                    <span className="text-md font-black uppercase tracking-wider drop-shadow-sm" style={{ fontFamily: currentTheme.font }}>Kingdoms</span>
                    {allianceMode !== 'ffa' && !activePuzzle && (
                      <span className="text-[10px] bg-emerald-100 text-emerald-800 border border-emerald-300 px-2 py-1 rounded font-bold uppercase flex items-center gap-1 shadow-sm">
                        <Link size={10} /> {allianceMode === 'diagonals' ? 'Diagonals' : 'Top/Bottom'}
                      </span>
                    )}
                  </div>
                  <div className="flex flex-col gap-3">
                    {COLORS.map(color => {
                      const isAlive = displayControlled[color].length > 0;
                      const isTurn = color === COLORS[displayTurnIndex] && !winner;
                      
                      if (activePuzzle && !isAlive && turnCount === 0) return null;

                      const aiTypeMap = {
                         'ai_aggressive': { icon: Swords, text: 'Aggressive' },
                         'ai_defensive': { icon: ShieldAlert, text: 'Defensive' },
                         'ai_diplomatic': { icon: Handshake, text: 'Diplomatic' }
                      };
                      const PTypeIcon = playerTypes[color].startsWith('ai') ? aiTypeMap[playerTypes[color]].icon : User;
                      const PTypeText = playerTypes[color].startsWith('ai') ? aiTypeMap[playerTypes[color]].text : 'Pass & Play';

                      const pieceTheme = THEMES[playerThemes[color]] || THEMES.medieval;

                      return (
                        <div key={color} className={`flex flex-col p-3 rounded-xl border-[3px] transition-all duration-300 ${isAlive ? (isTurn ? 'themed-panel border-emerald-500 scale-[1.02] shadow-lg' : 'themed-card') : 'themed-card opacity-50 grayscale'}`}>
                          <div className="flex items-center justify-between mb-2">
                            <div className="flex items-center gap-3">
                              <div className={`w-8 h-8 rounded-full shadow-sm flex items-center justify-center text-sm font-bold ${pieceTheme[color]}`}>
                                {isAlive ? PIECE_SYMBOLS['k'] : <Skull size={14} />}
                              </div>
                              <div className="flex flex-col leading-tight">
                                 <span className={`font-black ${isAlive ? '' : 'line-through opacity-70'}`}>
                                   {COLOR_NAMES[color]}
                                 </span>
                                 <span className="text-[10px] uppercase tracking-wider font-bold opacity-80 flex items-center gap-1 mt-0.5">
                                   <PTypeIcon size={10}/> {PTypeText}
                                 </span>
                              </div>
                            </div>
                            
                            {(timeControl !== null && !activePuzzle) && (
                              <span className={`font-mono text-lg font-black drop-shadow-sm ${timeLeft[color] < 60 && isAlive ? 'text-red-600 animate-pulse' : 'opacity-80'}`}>
                                {formatTime(timeLeft[color])}
                              </span>
                            )}
                          </div>
                          
                          <div className="flex items-center gap-1 mt-1 pl-11 flex-wrap">
                            {isAlive ? displayControlled[color].map(c => (
                              <div key={c} className={`w-3 h-3 rounded-full shadow-sm border border-black/20 ${pieceTheme[c]}`} title={`Controls ${COLOR_NAMES[c]}`} />
                            )) : (
                              <div className="flex items-center gap-1 text-xs text-red-800 font-bold bg-red-200 border border-red-300 px-2 py-0.5 rounded shadow-sm">
                                <Skull size={12} /> Eliminated
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </>
              ) : (
                // --- COMMS PANE ---
                <div className="flex flex-col h-full h-[400px]">
                   <div className="flex-grow overflow-y-auto themed-card rounded-xl p-3 mb-4 flex flex-col gap-3 shadow-inner custom-scrollbar">
                      {chatMessages.length === 0 && (
                        <div className="text-center opacity-50 font-bold text-sm mt-10 italic">No comms history yet.</div>
                      )}
                      {chatMessages.map(msg => (
                        <div key={msg.id} className={`flex flex-col ${msg.sender === currentPlayer ? 'items-end' : 'items-start'}`}>
                           <span className="text-[10px] font-black uppercase opacity-60 mb-0.5 px-1">{COLOR_NAMES[msg.sender]}</span>
                           <div className={`px-3 py-2 rounded-xl text-sm font-bold shadow-md max-w-[85%] text-white`} style={{ background: THEMES.classic[msg.sender]?.match(/from-([^ ]+)/)?.[1] || msg.sender }}>
                             {msg.text}
                           </div>
                        </div>
                      ))}
                      <div ref={chatEndRef} />
                   </div>
                   
                   <div className="flex flex-col gap-2">
                     <span className="text-[10px] uppercase font-black opacity-60 tracking-widest text-center">Quick Chats</span>
                     <div className="flex flex-wrap gap-2 justify-center">
                        {QUICK_CHATS.map((chat, idx) => (
                           <button 
                              key={idx}
                              onClick={() => sendQuickChat(chat)}
                              disabled={gameState !== 'playing' || (playerTypes[currentPlayer].startsWith('ai') && !isOnline)}
                              className="themed-card text-xs font-bold px-2 py-1.5 rounded-lg shadow-sm transition-all disabled:opacity-30 disabled:cursor-not-allowed hover:scale-105"
                           >
                              {chat}
                           </button>
                        ))}
                     </div>
                   </div>
                </div>
              )}
            </div>

          </div>
          
        </div>
      </div>
    </div>
  );
}