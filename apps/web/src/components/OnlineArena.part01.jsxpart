  function createRoom() {
    run(async () => {
      const payload = await api('/api/rooms/create', { mode, timeControlSeconds, centerPawns: false });
      setRoomCode(payload.code);
      setRoomCodeInput(payload.code);
    });
  }

  function joinRoom() {
    run(async () => {
      const normalized = roomCodeInput.trim().toUpperCase();
      const payload = await api('/api/rooms/join', { roomCode: normalized });
      setRoomCode(payload.code);
    });
  }

  function toggleReady() {
    if (!seat) return;
    run(() => api('/api/rooms/ready', { roomCode, ready: !room?.ready?.[seat] }));
  }

  function startMatch() {
    run(() => api('/api/rooms/start', { roomCode, fillWithAI: true }));
  }

  function clickSquare(index) {
    if (!canMove || !game) return;
    const piece = game.board[index];
    if (selected === null) {
      if (piece && (game.controlled?.[seat] || []).includes(piece.color)) setSelected(index);
      return;
    }
    if (selected === index) {
      setSelected(null);
      return;
    }
    if (validMoves.includes(index)) {
      const from = selected;
      setSelected(null);
      if (game.board[from]?.type === 'p' && isPromotionSquare(game.board[from], index)) {
        setPendingPromotion({ from, to: index, expectedVersion: game.version });
        return;
      }
      submitMove(from, index, 'q', game.version);
      return;
    }
    if (piece && (game.controlled?.[seat] || []).includes(piece.color)) setSelected(index);
    else setSelected(null);
  }

  function submitMove(from, to, promotion, expectedVersion) {
    setPendingPromotion(null);
    run(() => api('/api/rooms/move', { roomCode, from, to, promotion, expectedVersion }));
  }

  function resign() {
    if (!game) return;
    run(() => api('/api/rooms/resign', { roomCode, expectedVersion: game.version }));
  }

  function sendChat(message) {
    run(() => api('/api/rooms/chat', { roomCode, message }));
  }

  function disconnect() {
    window.localStorage.removeItem('kani_online_room');
    setRoomCode('');
    setRoom(null);
    setPlayers([]);
    setMessages([]);
    setPendingPromotion(null);
  }

  if (!firebaseReady) {
    return (
      <main className="grid min-h-[calc(100svh-56px)] place-items-center bg-[#f7f0e5] px-5 text-[#32281f]">
        <section className="w-full max-w-md text-center">
          <WifiOff className="mx-auto text-[#766c5d]" size={42} />
          <h1 className="mt-5 text-4xl">Online play unavailable</h1>
          <a href="/?hub=1" className="kani-action mt-7">Play locally</a>
        </section>
      </main>
    );
  }

  if (authLoading) {
    return <main className="grid min-h-[calc(100svh-56px)] place-items-center bg-[#f7f0e5] text-[#945921]"><Loader2 className="animate-spin" size={44} /></main>;
  }

  if (!roomCode) {
    return (
      <main className="min-h-[calc(100svh-56px)] bg-[#f7f0e5] px-5 py-9 text-[#32281f]">
        <section className="mx-auto max-w-4xl">
          <h1 className="mb-8 text-4xl sm:text-5xl">Play online</h1>
          {error && <p className="mb-5 text-sm text-red-800" role="status">{error}</p>}
          <div className="grid gap-9 md:grid-cols-2">
            <div>
              <h2 className="mb-5 text-2xl">Create a game</h2>
              <label className="mb-2 block text-sm" htmlFor="online-mode">Mode</label>
              <select id="online-mode" value={mode} onChange={(event) => setMode(event.target.value)}
                className="mb-4 w-full rounded-md border border-[#d4c3a7] bg-white p-3">
                <option value="ffa">Free for all</option>
                <option value="teams">Teams</option>
                <option value="blitz">Blitz</option>
              </select>
              <label className="mb-2 block text-sm" htmlFor="online-clock">Clock</label>
              <select id="online-clock" value={timeControlSeconds ?? 'unlimited'}
                onChange={(event) => setTimeControlSeconds(event.target.value === 'unlimited' ? null : Number(event.target.value))}
                disabled={mode === 'blitz'}
                className="mb-5 w-full rounded-md border border-[#d4c3a7] bg-white p-3">
                <option value="60">1 minute</option>
                <option value="180">3 minutes</option>
                <option value="300">5 minutes</option>
                <option value="unlimited">Unlimited</option>
              </select>
              <button onClick={createRoom} disabled={busy || !user} className="kani-action w-full">
                {busy ? <Loader2 className="animate-spin" size={19}/> : <DoorOpen size={19}/>} Create game
              </button>
            </div>
            <div className="border-t border-[#d4c3a7] pt-8 md:border-l md:border-t-0 md:pl-9 md:pt-0">
              <h2 className="mb-5 text-2xl">Join a game</h2>
              <label className="mb-2 block text-sm" htmlFor="join-code">Invite code</label>
              <input id="join-code" value={roomCodeInput}
                onChange={(event) => setRoomCodeInput(event.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 6))}
                placeholder="ABC234" maxLength={6} autoComplete="off"
                className="mb-5 w-full rounded-md border border-[#d4c3a7] bg-white p-3 text-center text-2xl tracking-widest"/>
              <button onClick={joinRoom} disabled={busy || roomCodeInput.length !== 6 || !user}
                className="kani-action w-full"><Users size={19}/> Join game</button>
            </div>
          </div>
        </section>
      </main>
    );
  }

  if (!room) {
    return <main className="grid min-h-[calc(100svh-56px)] place-items-center bg-[#f7f0e5] text-[#945921]"><Loader2 className="animate-spin" size={44} /></main>;
  }

  if (room.status === 'lobby') {
    const occupiedSeats = COLORS.filter((candidate) => room.seats?.[candidate]);
    const allReady = occupiedSeats.length >= 2 && occupiedSeats.every((candidate) => room.ready?.[candidate]);
    return (
      <main className="min-h-[calc(100svh-56px)] bg-[#f7f0e5] px-5 py-9 text-[#32281f]">
        <section className="mx-auto max-w-3xl">
          <div className="mb-7 flex items-center justify-between gap-3">
            <div>
              <h1 className="text-4xl">Your game</h1>
              <div className="mt-3 flex items-center gap-3">
                <span className="text-xl tracking-[0.22em] text-[#7c431a]" aria-label={`Invite code ${roomCode}`}>{roomCode}</span>
                <button onClick={() => navigator.clipboard?.writeText(roomCode)} aria-label="Copy invite code" title="Copy invite code"
                  className="text-[#59432d]"><Copy size={19}/></button>
              </div>
            </div>
            <button onClick={disconnect} className="kani-link text-sm">Leave</button>
          </div>
          {error && <p role="status" className="mb-4 text-red-800">{error}</p>}
          <div className="divide-y divide-[#d4c3a7]">
            {COLORS.map((candidate) => {
              const player = playersBySeat[candidate];
              const occupied = Boolean(room.seats?.[candidate]);
              return (
                <div key={candidate} className="flex items-center gap-4 py-4">
                  <span className={`grid h-10 w-10 place-items-center rounded-full border text-xl ${SEAT_STYLES[candidate]}`}>♚</span>
                  <span className="flex-1">{occupied ? player?.displayName || COLOR_NAMES[candidate] : 'Computer'}</span>
                  {occupied ? (room.ready?.[candidate] ? <Check size={20} className="text-[#95631c]" aria-label="Ready"/> :
                    <span className="text-sm text-stone-600">Waiting</span>) : <Bot className="text-stone-500" size={20} aria-label="Computer player"/>}
                </div>
              );
            })}
          </div>
          <div className="mt-8 flex flex-wrap gap-3">
            <button onClick={toggleReady} disabled={!seat || busy} className="kani-action">
              {room.ready?.[seat] ? 'Not ready' : 'Ready'}
            </button>
            {isHost && <button onClick={startMatch} disabled={!allReady || busy}
              className="kani-action disabled:opacity-40"><Play size={18} fill="currentColor"/> Start game</button>}
          </div>
        </section>
      </main>
    );
  }

  // Pieces remain mounted under stable IDs as their board position changes.
  // The browser interpolates their translate3d positions even for remote moves.
  const visibleMove = game ? lastMoveVisual(game.lastMove, game.board) : null;
  const currentName = game?.winner || COLOR_NAMES[currentSeat] || 'Complete';
  return (
    <main className="min-h-[calc(100svh-56px)] bg-[#f7f0e5] p-3 text-[#32281f] sm:p-5">
      {pendingPromotion && (
        <div className="fixed inset-0 z-50 grid place-items-center bg-black/75 p-5" role="dialog" aria-modal="true" aria-label="Choose pawn promotion">
          <section className="w-full max-w-sm rounded-2xl border border-amber-300/50 bg-stone-950 p-6 shadow-2xl">
            <h2 className="mb-2 text-2xl font-bold">Promote your pawn</h2>
            
            <div className="grid grid-cols-4 gap-2">
              {['q', 'r', 'b', 'n'].map((type) => (
                <button key={type} type="button" disabled={busy} onClick={() => submitMove(pendingPromotion.from, pendingPromotion.to, type, pendingPromotion.expectedVersion)}
                  className="rounded-xl border border-amber-400/40 bg-amber-300/10 p-3 text-3xl hover:bg-amber-300/20"
                  aria-label={ { q: 'Queen', r: 'Rook', b: 'Bishop', n: 'Knight' }[type] }>{SYMBOLS[type]}</button>
              ))}
            </div>
            <button type="button" onClick={() => setPendingPromotion(null)} className="mt-5 w-full rounded-lg border border-[#a89378] px-3 py-2">Cancel</button>
          </section>
        </div>
      )}
      <section className="mx-auto max-w-7xl">
        <div className="mb-4 flex flex-wrap items-center justify-between gap-3 border-b border-[#d4c3a7] pb-3">
          <div><h1 className="text-2xl">{game?.status === 'complete' ? `${currentName} wins` : `${currentName} to move`}</h1><p className="mt-1 text-sm text-stone-600">Game {roomCode}</p></div>
          <div className="flex items-center gap-2"><button onClick={resign} disabled={!game || game.status !== 'active' || busy} className="rounded-xl border border-red-500/50 bg-red-950/40 px-4 py-2 font-bold text-red-200 disabled:opacity-40">Resign</button></div>
        </div>
        {error && <div className="mb-4 rounded-xl border border-red-400/40 bg-red-950/60 p-4 text-red-100">{error}</div>}
        <div className="grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
          <div className="flex flex-col items-center">
            <div className="mb-4 grid w-full max-w-2xl grid-cols-4 gap-2">
              {COLORS.map((candidate) => (
                <div key={candidate} className={`rounded-xl border p-2 text-center ${candidate === currentSeat ? 'border-amber-300 bg-amber-300/10' : 'border-[#d4c3a7] bg-[#fffaf0]'}`}>
                  <div className="text-xs font-black">{COLOR_NAMES[candidate]}</div><div className="mt-1 flex items-center justify-center gap-1 font-mono text-sm"><Clock3 size={13} />{formatClock(clocks[candidate])}</div>
                </div>
              ))}
            </div>
            <div className="relative aspect-square w-full max-w-[680px] overflow-hidden rounded-2xl border-[6px] border-[#ab8154] shadow-[0_10px_30px_rgba(71,43,21,0.16)]" aria-label="KANI four-way chess board">
              <div className="absolute inset-0 grid grid-cols-8">
                {(game?.board || []).map((piece, index) => {
                  const row = Math.floor(index / 8);
                  const column = index % 8;
                  const selectedSquare = selected === index;
                  const valid = validMoves.includes(index);
                  const lastSource = visibleMove?.from === index;
                  const lastDestination = visibleMove?.to === index;
                  return (
                    <button key={index} onClick={() => clickSquare(index)} disabled={!canMove}
                      className={`relative grid place-items-center text-[clamp(1.5rem,6vw,3.6rem)] ${(row + column) % 2 === 0 ? 'bg-[#f5dfb8]' : 'bg-[#b98b60]'} ${selectedSquare ? 'ring-4 ring-inset ring-amber-300' : ''} ${valid ? 'after:absolute after:h-3 after:w-3 after:rounded-full after:bg-emerald-400/80' : ''} disabled:cursor-default`}
                      aria-label={`Board square ${index + 1}${piece ? ` ${COLOR_NAMES[piece.color]} ${piece.type}` : ''}`}>
                      {(lastSource || lastDestination) && (
                        <span className={`pointer-events-none absolute inset-0 ${lastDestination ? 'bg-amber-300/35 ring-2 ring-inset ring-amber-400/70' : 'bg-amber-200/20'}`} aria-hidden="true" />
                      )}
                    </button>
                  );
                })}
              </div>
              {/* A separate keyed piece layer lets CSS animate movement between squares.
                  The square buttons stay interactive underneath this pointer-safe layer. */}
              <div className="pointer-events-none absolute inset-0 z-10" aria-hidden="true">
                {(game?.board || []).map((piece, index) => piece ? (
                  <div key={piece.id || `piece-${index}`}
                    className="kani-board-piece absolute left-0 top-0 grid h-[12.5%] w-[12.5%] place-items-center text-[clamp(1.5rem,6vw,3.6rem)]"
                    style={{ transform: pieceTransform(index) }}>
                    <span className={`grid h-[75%] w-[75%] place-items-center rounded-full border-2 shadow-lg ${SEAT_STYLES[piece.color]}`}>
                      {SYMBOLS[piece.type]}
                    </span>
                  </div>
                ) : null)}
              </div>
            </div>
            <p className="mt-3 text-center text-sm text-stone-600" aria-live="polite">{canMove ? 'Your move' : game?.status === 'complete' ? 'Game over' : 'Waiting'}</p>
          </div>
          <aside className="space-y-4">
            <div className="rounded-2xl border border-[#d4c3a7] bg-white/80 p-4">
              <h2 className="mb-3 flex items-center gap-2 font-black text-[#925b24]"><Users size={18} /> Players</h2>
              <div className="space-y-2">{COLORS.map((candidate) => <div key={candidate} className="flex items-center justify-between rounded-lg bg-[#efe1ce] p-2 text-sm"><span>{COLOR_NAMES[candidate]}</span><span className="text-xs text-stone-600">{room.seats?.[candidate] ? playersBySeat[candidate]?.displayName || 'Human' : 'Server AI'}</span></div>)}</div>
            </div>
            <div className="rounded-2xl border border-[#d4c3a7] bg-[#fffaf1] p-4">
              <h2 className="mb-3 flex items-center gap-2 font-black text-blue-300"><MessageCircle size={18} /> Quick chat</h2>
              <div className="max-h-40 space-y-2 overflow-auto rounded-xl bg-black/20 p-2 text-sm">{messages.length ? messages.map((message) => <p key={message.id}><strong>{message.seat}:</strong> {message.message}</p>) : <p className="text-stone-500">No messages yet.</p>}</div>
              <div className="mt-3 grid grid-cols-2 gap-2">{QUICK_CHATS.slice(4).map((message) => <button key={message} onClick={() => sendChat(message)} disabled={busy} className="rounded-lg border border-[#d4c3a7] bg-[#efe1ce] p-2 text-xs font-bold hover:bg-white/10">{message}</button>)}</div>
            </div>
            <button onClick={() => window.location.reload()} className="flex w-full items-center justify-center gap-2 rounded-xl border border-[#d4c3a7] p-3 font-bold"><RefreshCcw size={17} /> Reconnect view</button>
          </aside>
        </div>
      </section>
    </main>
  );
}
