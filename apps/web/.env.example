# Public Firebase web-app configuration (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_KANI_APP_ID=kani-4way-corner-chess

# Optional server-only alias for the same Firebase Web API key. The backend uses
# accounts:lookup to validate the client ID token before accessing Firestore.
FIREBASE_WEB_API_KEY=

# Firebase Admin server credentials. Choose ONE representation.
# Preferred on Vercel: a base64-encoded service-account JSON document.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Or raw JSON:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or individual fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe must remain in TEST mode for the alpha.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
KANI_STRIPE_REQUIRE_TEST_MODE=true

# Canonical deployed origin used in Checkout success/cancel URLs.
APP_BASE_URL=https://kani-4way-corner-chess.vercel.app
NEXT_PUBLIC_APP_URL=https://kani-4way-corner-chess.vercel.app
